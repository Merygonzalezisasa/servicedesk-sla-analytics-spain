# Copiar este archivo como .env y completar los valores.
# .env NO se sube a git (está en .gitignore); este .env.example sí, sin valores secretos.

# --- PostgreSQL (servicio local postgresql-x64-16) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicedesk_sla
DB_SCHEMA=servicedesk
DB_USER=analista
DB_PASSWORD=

# --- Fuentes externas reales (no requieren API key) ---
OPEN_METEO_URL=https://archive-api.open-meteo.com/v1/archive
NAGER_URL=https://date.nager.at/api/v3/PublicHolidays
# Coordenadas de la sede de soporte (Madrid)
SEDE_LAT=40.4168
SEDE_LON=-3.7038
PAIS_ISO2=ES
COMUNIDAD_ISO=ES-MD

# --- Período del proyecto ---
FECHA_INICIO=2024-01-01
FECHA_FIN=2025-12-31
