	measure 'Tendencia Balance SVG' =
			
			VAR SprintActual =
			    MAX ( 'Sprint'[Sprint] )
			
			VAR Periodo =
			    TOPN (
			        8,
			        FILTER (
			            ALL ( 'Sprint'[Sprint] ),
			            'Sprint'[Sprint] <= SprintActual
			        ),
			        'Sprint'[Sprint], DESC
			    )
			
			VAR Datos =
			    ADDCOLUMNS (
			        Periodo,
			        "@Valor", CALCULATE ( [Balance €] )
			    )
			
			VAR Minimo = MINX ( Datos, [@Valor] )
			VAR Maximo = MAXX ( Datos, [@Valor] )
			VAR Numero = COUNTROWS ( Datos )
			
			VAR ColorLinea =
			    IF ( [Balance €] >= 0, "%232E8B57", "%23C23D38" )
			
			VAR Puntos =
			    CONCATENATEX (
			        Datos,
			        VAR Posicion =
			            RANKX (
			                Periodo,
			                'Sprint'[Sprint],
			                ,
			                ASC,
			                DENSE
			            )
			        VAR X =
			            8 + DIVIDE ( ( Posicion - 1 ) * 144, Numero - 1, 0 )
			        VAR Y =
			            IF (
			                Maximo = Minimo,
			                23,
			                38 - DIVIDE (
			                    ( [@Valor] - Minimo ) * 30,
			                    Maximo - Minimo
			                )
			            )
			        RETURN
			            FORMAT ( X, "0.0", "en-US" ) & ","
			            & FORMAT ( Y, "0.0", "en-US" ),
			        " ",
			        'Sprint'[Sprint], ASC
			    )
			
			RETURN
			IF (
			    Numero < 2,
			    BLANK (),
			    "data:image/svg+xml;utf8,"
			        & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 160 46'>"
			        & "<polyline points='" & Puntos
			        & "' fill='none' stroke='" & ColorLinea & "'"
			        & " stroke-width='3' stroke-linecap='round'"
			        & " stroke-linejoin='round'/>"
			        & "</svg>"
			)
		displayFolder: 05 Facturación
		lineageTag: c77e8254-b386-4cce-af9b-80da4a227480
		dataCategory: ImageUrl

	/// Leyenda de la tarjeta de facturación acumulada.
	measure 'Texto sprints analizados' = DISTINCTCOUNT('Facturación'[Sprint id]) & " sprints analizados"
		displayFolder: 05 Facturación
