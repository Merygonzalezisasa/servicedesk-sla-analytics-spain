	column Medidas
		dataType: string
		isHidden
		lineageTag: c7308420-35bf-4a18-b636-b328c0c43c60
		summarizeBy: none
		sourceColumn: [Medidas]

	partition Medidas = calculated
		mode: import
		source = ROW("Medidas", "")

