			        ),
			        'Sprint'[Sprint], DESC
			    )
			
			VAR Datos =
			    ADDCOLUMNS (
			        Periodo,
			        "@Valor", CALCULATE ( [Penalización €] )
			    )
			
			VAR Minimo = MINX ( Datos, [@Valor] )
			VAR Maximo = MAXX ( Datos, [@Valor] )
			VAR Numero = COUNTROWS ( Datos )
			
			VAR Puntos =
			    CONCATENATEX (
			        Datos,
			        VAR Posicion =
			            RANKX (
			                Periodo,
			                'Sprint'[Sprint],
			                ,
			                ASC,
			                DENSE
			            )
			        VAR X =
			            8 + DIVIDE ( ( Posicion - 1 ) * 144, Numero - 1, 0 )
			        VAR Y =
			            IF (
			                Maximo = Minimo,
			                23,
			                38 - DIVIDE (
			                    ( [@Valor] - Minimo ) * 30,
			                    Maximo - Minimo
			                )
			            )
			        RETURN
			            FORMAT ( X, "0.0", "en-US" ) & ","
			            & FORMAT ( Y, "0.0", "en-US" ),
