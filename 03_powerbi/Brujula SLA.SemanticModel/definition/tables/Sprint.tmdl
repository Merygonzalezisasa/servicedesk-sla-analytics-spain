/// Sprints de 3 semanas (lunes → viernes de la 3ª). Unidad de medición del SLA y de facturación.
table Sprint
	lineageTag: e8f58cea-fc35-4c4a-8b20-91f7e7ceecb9

	/// AAAA-NN por el año en que empieza
	column Sprint
		dataType: string
		isKey
		lineageTag: c5e50d58-1297-4766-bc63-c693a843c219
		summarizeBy: none
		sourceColumn: sprint_id
		sortByColumn: Orden

	/// Año del sprint (2024-18 acaba en enero de 2025 pero es de 2024)
	column Año
		dataType: int64
		lineageTag: b6280b03-7281-40e0-9e11-130c6cd5de57
		summarizeBy: none
		sourceColumn: anio_sprint

	column Número
		dataType: int64
		lineageTag: 5229d08e-9f25-4374-bf03-0aee291af972
		summarizeBy: none
		sourceColumn: numero

	/// Sprint con sus fechas, p. ej. 2024-11 · 29/07–16/08
	column Periodo
		dataType: string
		lineageTag: b7ad5aca-636b-420a-a618-6c224da1d227
		summarizeBy: none
		sourceColumn: periodo
		sortByColumn: Orden

	column Inicio
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: d24cf43d-aeca-4bd0-9c5c-4e04feef455c
		summarizeBy: none
		sourceColumn: fecha_inicio

	column Fin
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: b6a34f0a-7150-4f63-908b-91b7b088db3a
		summarizeBy: none
		sourceColumn: fecha_fin

	column 'Días laborables'
		dataType: int64
		lineageTag: 28ce8c94-83e3-466c-b019-e5722eed5388
		summarizeBy: none
		sourceColumn: dias_laborables

	/// Posición del sprint (1 = 2024-01): sirve para encontrar el sprint anterior
	column Orden
		dataType: int64
		isHidden
		lineageTag: dfbc3bf9-ad38-4514-ae2a-a28e4c86954d
		summarizeBy: none
		sourceColumn: orden

	/// Etiqueta corta para ejes: año completo solo en el primer sprint del año
	column 'Etiqueta eje' = IF(Sprint[Número] = 1, Sprint[Sprint], FORMAT(Sprint[Número], "00") & REPT(UNICHAR(8203), Sprint[Año] - 2024))
		dataType: string
		lineageTag: bf942e80-faa5-4e96-805a-1bedc9986b7f
		summarizeBy: none
		sortByColumn: Orden

	partition Sprint = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database(Servidor, #"Base de datos"),
					Tabla = Origen{[Schema = "servicedesk", Item = "dim_sprint"]}[Data],
					#"Seleccionadas columnas" = Table.SelectColumns(Tabla, {"sprint_id", "anio_sprint", "numero", "fecha_inicio", "fecha_fin", "dias_laborables"}),
					#"Ordenadas filas" = Table.Sort(#"Seleccionadas columnas", {{"fecha_inicio", Order.Ascending}}),
					#"Añadido orden" = Table.AddIndexColumn(#"Ordenadas filas", "orden", 1, 1, Int64.Type),
					#"Añadido periodo" = Table.AddColumn(#"Añadido orden", "periodo",
						each [sprint_id] & " · " & Date.ToText([fecha_inicio], "dd/MM") & "–" & Date.ToText([fecha_fin], "dd/MM"), type text),
					#"Cambiados tipos" = Table.TransformColumnTypes(#"Añadido periodo", {
						{"anio_sprint", Int64.Type}, {"numero", Int64.Type}, {"dias_laborables", Int64.Type},
						{"fecha_inicio", type date}, {"fecha_fin", type date}})
				in
					#"Cambiados tipos"

